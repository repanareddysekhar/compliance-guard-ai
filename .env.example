# ArmorIQ SDK (optional — disabled for local LLM-only POC)
ARMORIQ_ENABLED=false
ARMORIQ_API_KEY=ak_live_9a909a917a207e540d6b69c31e5245c3732e71ca0e2dc7e1d0bcbba23f271391
ARMORIQ_ENFORCEMENT_MODE=blocking          # blocking | warning | audit_only
ARMORIQ_CRYPTOGRAPHIC_AUDIT=true

# LLM Provider — local Ollama by default (no cloud API key needed for POC)
LLM_PROVIDER=ollama                          # ollama | openai | anthropic
LLM_BASE_URL=http://localhost:11434/v1       # Ollama OpenAI-compatible endpoint
LLM_MODEL=llama3.2:3b                         # tool-capable; or llama3.1
LLM_MAX_TOKENS=4096
LLM_MAX_TURNS=60
LLM_TIMEOUT_SECONDS=120

# Optional cloud providers (only if LLM_PROVIDER is changed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
ARMORIQ_MODE=sdk                             # sdk sends enforce/audit to ArmorIQ cloud
ARMORIQ_USER_EMAIL=scanner@complianceguard.local
ARMORIQ_AGENT_ID=ComplianceGuard-Scanner
ARMORIQ_MCP_NAME=ComplianceGuard

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/complianceguard

# API
COMPLIANCEGUARD_API_KEY=your_internal_api_key_here
CORS_ORIGINS=["http://localhost:5173"]

# OPA
OPA_POLICY_PATH=./policies/

# Feature Flags
ENABLE_AUTO_FIX=false                      # MVP: false. Post-MVP: true
ENABLE_MULTI_TENANT=false
